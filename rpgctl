#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BACKEND_DIR="$ROOT_DIR/backend"
FRONTEND_DIR="$ROOT_DIR/frontend"
AUDIO_ENGINE_DIR="$ROOT_DIR/audio_engine"
SPOTIFY_DIR="$ROOT_DIR/spotify"
RUN_DIR="$ROOT_DIR/.run"
LOG_DIR="$ROOT_DIR/logs"

AUDIO_ENGINE_HOST="${AUDIO_ENGINE_HOST:-127.0.0.1}"
AUDIO_ENGINE_PORT="${AUDIO_ENGINE_PORT:-8001}"
BACKEND_HOST="${BACKEND_HOST:-127.0.0.1}"
BACKEND_PORT="${BACKEND_PORT:-8000}"
FRONTEND_HOST="${FRONTEND_HOST:-0.0.0.0}"
FRONTEND_PORT="${FRONTEND_PORT:-5173}"
FRONTEND_ORIGIN="${FRONTEND_ORIGIN:-https://home.dyyyl.ovh}"
BLUEZ_ADAPTER_PATH="${BLUEZ_ADAPTER_PATH:-/org/bluez/hci0}"
STEREO_UPMIX_SINK_NAME="${STEREO_UPMIX_SINK_NAME:-stereo_upmix_input}"
RPGCTL_BOOT_WAIT_TIMEOUT="${RPGCTL_BOOT_WAIT_TIMEOUT:-120}"
RPGCTL_AUDIO_WAIT_TIMEOUT="${RPGCTL_AUDIO_WAIT_TIMEOUT:-60}"
LAN_IP="${LAN_IP:-}"
API_BASE_URL="${API_BASE_URL:-}"

if [[ -z "${AUDIO_ENGINE_URL:-}" ]]; then
  AUDIO_ENGINE_URL="http://127.0.0.1:$AUDIO_ENGINE_PORT"
fi

SPOTIFY_PID="$RUN_DIR/spotify.pid"
SPOTIFY_LOG="$LOG_DIR/spotify.log"
AUDIO_ENGINE_PID="$RUN_DIR/audio_engine.pid"
BACKEND_PID="$RUN_DIR/backend.pid"
FRONTEND_PID="$RUN_DIR/frontend.pid"
FRONTEND_AUTH_FILE="${FRONTEND_AUTH_FILE:-$RUN_DIR/frontend-auth.json}"
FRONTEND_TLS_CERT="${FRONTEND_TLS_CERT:-$RUN_DIR/frontend-cert.pem}"
FRONTEND_TLS_KEY="${FRONTEND_TLS_KEY:-$RUN_DIR/frontend-key.pem}"
BLUETOOTH_AGENT_PID="$RUN_DIR/bluetooth_agent.pid"
AUDIO_ENGINE_LOG="$LOG_DIR/audio_engine.log"
BACKEND_LOG="$LOG_DIR/backend.log"
FRONTEND_LOG="$LOG_DIR/frontend.log"
BLUETOOTH_AGENT_LOG="$LOG_DIR/bluetooth_agent.log"
APP_LOG="$LOG_DIR/app.log"
RPGCTL_COMPONENTS=(
  audio_engine
  spotify
  backend
  bluetooth
  frontend
  mixer
)
RPGCTL_COMMANDS=(
  build
  start
  stop
  restart
  status
  logs
  logs-audio
  logs-spotify
  logs-api
  logs-bt
  logs-ui
  logs-app
  mixer
  add-user
  remove-user
  set-password
  list-user
  setup-https
  completion
  install-completion
  help
)

usage() {
  cat <<'EOF'
Usage: ./rpgctl <command> [component]

Commands:
  build       Install dependencies and build from fresh sources
  start       Start audio engine, mixer, Spotify, backend, Bluetooth agent, and frontend, or one component
  stop        Stop frontend, Bluetooth agent, backend, Spotify, mixer, and audio engine, or one component
  restart     Build, then restart audio engine, mixer, Spotify, backend, Bluetooth agent, and frontend, or one component
  status      Show process and URL status
  logs        Follow audio engine, Spotify, backend, frontend, and app logs
  logs-spotify Follow Spotify Connect log
  logs-audio  Follow audio engine log
  logs-api    Follow backend log
  logs-bt     Follow Bluetooth pairing agent log
  logs-ui     Follow frontend log
  logs-app    Follow application and browser-client message log
  mixer       Control the standalone surround_mixer service
  add-user <username>
              Add a frontend user and prompt for a password
  remove-user <username>
              Remove an existing frontend user
  set-password <username>
              Change an existing frontend user's password
  list-user   List configured frontend usernames
  setup-https [hostname]
              Generate a self-signed TLS certificate for the frontend
  completion  Print shell completion script
  install-completion
              Install Bash tab completion for this checkout

Components for build/start/stop/restart:
  audio_engine backend bluetooth frontend mixer spotify

Environment overrides:
  AUDIO_ENGINE_PORT=8001
  BACKEND_HOST=127.0.0.1
  BACKEND_PORT=8000
  FRONTEND_PORT=5173
  FRONTEND_ORIGIN=https://home.dyyyl.ovh
  AUDIO_ENGINE_URL=http://127.0.0.1:8001
  BLUEZ_ADAPTER_PATH=/org/bluez/hci0
  SPOTIFY_NAME="RPG Player"
  SPOTIFY_BITRATE=320
  SPOTIFY_INITIAL_VOLUME=75
  STEREO_UPMIX_SINK_NAME=stereo_upmix_input
  RPGCTL_BOOT_WAIT_TIMEOUT=120
  RPGCTL_AUDIO_WAIT_TIMEOUT=60
  LAN_IP=192.168.1.100
  API_BASE_URL=http://192.168.1.100:8000
  FRONTEND_AUTH_FILE=/path/to/frontend-auth.json
  FRONTEND_TLS_CERT=/path/to/fullchain.pem
  FRONTEND_TLS_KEY=/path/to/privkey.pem
EOF
}

print_bash_completion() {
  local commands
  local components
  commands="${RPGCTL_COMMANDS[*]}"
  components="${RPGCTL_COMPONENTS[*]}"

  cat <<EOF
_rpgctl_completion() {
  local cur commands components
  COMPREPLY=()
  cur="\${COMP_WORDS[COMP_CWORD]}"
  commands="$commands"
  components="$components"

  if [[ "\$COMP_CWORD" -eq 1 ]]; then
    COMPREPLY=(\$(compgen -W "\$commands" -- "\$cur"))
    return 0
  fi

  if [[ "\${COMP_WORDS[1]}" =~ ^(build|start|stop|restart)$ && "\$COMP_CWORD" -eq 2 ]]; then
    COMPREPLY=(\$(compgen -W "\$components" -- "\$cur"))
    return 0
  fi

  if [[ "\${COMP_WORDS[1]}" == "completion" && "\$COMP_CWORD" -eq 2 ]]; then
    COMPREPLY=(\$(compgen -W "bash" -- "\$cur"))
    return 0
  fi

  if [[ "\${COMP_WORDS[1]}" == "mixer" && "\$COMP_CWORD" -eq 2 ]]; then
    COMPREPLY=(\$(compgen -W "status ensure start stop restart config" -- "\$cur"))
    return 0
  fi
}
EOF
  printf 'complete -F _rpgctl_completion rpgctl\n'
  printf 'complete -F _rpgctl_completion ./rpgctl\n'
  printf 'complete -F _rpgctl_completion %q\n' "$ROOT_DIR/rpgctl"
}

install_completion() {
  local completion_dir="${XDG_DATA_HOME:-$HOME/.local/share}/rpg-player"
  local completion_file="$completion_dir/rpgctl-completion.bash"
  local rc_file="$HOME/.bashrc"
  local source_line="source \"$completion_file\""

  mkdir -p "$completion_dir"
  print_bash_completion >"$completion_file"

  if [[ -f "$rc_file" ]] && grep -Fxq "$source_line" "$rc_file"; then
    echo "Bash completion is already installed:"
    echo "  $completion_file"
    return
  fi

  printf '\n# RPG Audio Server command completion\n%s\n' "$source_line" >>"$rc_file"
  echo "Bash completion installed:"
  echo "  $completion_file"
  echo "Open a new terminal, or run:"
  echo "  source \"$completion_file\""
}

ensure_dirs() {
  mkdir -p "$RUN_DIR" "$LOG_DIR"
}

require_command() {
  local command_name="$1"
  local install_hint="$2"

  if ! command -v "$command_name" >/dev/null 2>&1; then
    echo "Missing required command: $command_name"
    echo "$install_hint"
    exit 1
  fi
}

detect_lan_ip() {
  if [[ -n "$LAN_IP" ]]; then
    printf '%s\n' "$LAN_IP"
    return
  fi

  if command -v hostname >/dev/null 2>&1; then
    local from_hostname
    from_hostname="$(hostname -I 2>/dev/null | awk '{print $1}')"
    if [[ -n "$from_hostname" ]]; then
      printf '%s\n' "$from_hostname"
      return
    fi
  fi

  if command -v ip >/dev/null 2>&1; then
    local from_route
    from_route="$(ip route get 1.1.1.1 2>/dev/null | awk '{for (i=1; i<=NF; i++) if ($i == "src") {print $(i+1); exit}}')"
    if [[ -n "$from_route" ]]; then
      printf '%s\n' "$from_route"
      return
    fi
  fi

  printf '127.0.0.1\n'
}

pid_is_running() {
  local pid_file="$1"
  [[ -f "$pid_file" ]] || return 1
  local pid
  pid="$(cat "$pid_file")"
  [[ -n "$pid" ]] || return 1
  kill -0 "$pid" >/dev/null 2>&1
}

port_process_ids() {
  local port="$1"

  if command -v fuser >/dev/null 2>&1; then
    fuser -n tcp "$port" 2>/dev/null | tr ' ' '\n' | grep -E '^[0-9]+$' || true
    return
  fi

  if command -v lsof >/dev/null 2>&1; then
    lsof -ti "tcp:$port" 2>/dev/null || true
    return
  fi

  if command -v ss >/dev/null 2>&1; then
    ss -ltnp "sport = :$port" 2>/dev/null \
      | sed -n 's/.*pid=\([0-9][0-9]*\).*/\1/p' \
      | sort -u || true
  fi
}

stop_port_processes() {
  local label="$1"
  local port="$2"
  local stopped=0
  local pid

  while read -r pid; do
    if [[ -z "$pid" || "$pid" == "$$" ]]; then
      continue
    fi
    stop_process_id "$pid"
    stopped=1
  done < <(port_process_ids "$port")

  if [[ "$stopped" -eq 1 ]]; then
    echo "$label process on port $port stopped."
  fi
}

process_cwd_matches() {
  local pid="$1"
  local expected_dir="$2"
  local cwd

  cwd="$(readlink "/proc/$pid/cwd" 2>/dev/null || true)"
  [[ "$cwd" == "$expected_dir" ]]
}

process_args_match() {
  local pid="$1"
  local pattern="$2"
  local args

  args="$(ps -p "$pid" -o args= 2>/dev/null || true)"
  [[ -n "$args" ]] && grep -Eq "$pattern" <<<"$args"
}

stop_process_id() {
  local pid="$1"

  kill -- "-$pid" >/dev/null 2>&1 || true
  kill "$pid" >/dev/null 2>&1 || true

  for _ in {1..20}; do
    if ! kill -0 "$pid" >/dev/null 2>&1; then
      return
    fi
    sleep 0.15
  done

  kill -9 -- "-$pid" >/dev/null 2>&1 || true
  kill -9 "$pid" >/dev/null 2>&1 || true
}

stop_project_processes() {
  local label="$1"
  local cwd="$2"
  local pattern="$3"
  local stopped=0
  local proc pid

  for proc in /proc/[0-9]*; do
    pid="${proc##*/}"
    if [[ "$pid" == "$$" ]]; then
      continue
    fi
    if process_cwd_matches "$pid" "$cwd" && process_args_match "$pid" "$pattern"; then
      stop_process_id "$pid"
      stopped=1
    fi
  done

  if [[ "$stopped" -eq 1 ]]; then
    echo "$label stray project process stopped."
  fi
}

stop_stale_project_servers() {
  stop_project_processes "Spotify" "$SPOTIFY_DIR" "(librespot|python.*service[.]py)"
  stop_project_processes "Audio engine" "$AUDIO_ENGINE_DIR" "(uvicorn|python).*app\.main:app"
  stop_project_processes "Backend" "$BACKEND_DIR" "(uvicorn|python).*app\.main:app"
  stop_project_processes "Bluetooth agent" "$BACKEND_DIR" "(python).*scripts/bluez_pairing_agent\.py"
  stop_project_processes "Frontend" "$FRONTEND_DIR" "(production_server\.py|npm run dev|vite|node).*vite"
  stop_port_processes "Audio engine" "$AUDIO_ENGINE_PORT"
  stop_port_processes "Backend" "$BACKEND_PORT"
  stop_port_processes "Frontend" "$FRONTEND_PORT"
}

wait_for_start() {
  local label="$1"
  local pid_file="$2"
  local log_file="$3"

  sleep 1
  if ! pid_is_running "$pid_file"; then
    echo "$label failed to stay running. Last log lines:"
    tail -n 20 "$log_file" 2>/dev/null || true
    exit 1
  fi
}

wait_for_system_boot() {
  if ! command -v systemctl >/dev/null 2>&1; then
    return
  fi

  local deadline=$((SECONDS + RPGCTL_BOOT_WAIT_TIMEOUT))
  local state

  while (( SECONDS < deadline )); do
    state="$(systemctl is-system-running 2>/dev/null || true)"
    case "$state" in
      running|degraded|maintenance)
        return
        ;;
      starting|initializing|"")
        sleep 1
        ;;
      *)
        return
        ;;
    esac
  done

  echo "System boot did not report ready within ${RPGCTL_BOOT_WAIT_TIMEOUT}s; continuing startup."
}

wait_for_audio_server() {
  if ! command -v pactl >/dev/null 2>&1; then
    return
  fi

  local deadline=$((SECONDS + RPGCTL_AUDIO_WAIT_TIMEOUT))
  local last_error=""

  while (( SECONDS < deadline )); do
    if pactl info >/dev/null 2>&1; then
      return
    fi
    last_error="$(pactl info 2>&1 || true)"
    sleep 1
  done

  echo "Pulse/PipeWire did not become ready within ${RPGCTL_AUDIO_WAIT_TIMEOUT}s."
  if [[ -n "$last_error" ]]; then
    echo "Last pactl error:"
    echo "  $last_error"
  fi
  echo "Continuing startup; the audio engine will report mixer errors if audio is still unavailable."
}

verify_backend_api() {
  local url="http://127.0.0.1:$BACKEND_PORT/api/playback"
  local response
  local last_response=""

  if ! command -v curl >/dev/null 2>&1; then
    return
  fi

  for _ in {1..40}; do
    if ! pid_is_running "$BACKEND_PID"; then
      echo "Backend exited before the API became ready. Last log lines:"
      tail -n 30 "$BACKEND_LOG" 2>/dev/null || true
      return
    fi

    response="$(curl -fsS --max-time 1 "$url" 2>/dev/null || true)"
    if [[ "$response" == *'"players"'* ]]; then
      return
    fi
    if [[ -n "$response" ]]; then
      last_response="$response"
    fi
    sleep 0.25
  done

  echo "Backend started, but /api/playback did not become ready with the Phase 3 player deck."
  echo "Continuing startup; open /api/playback in the browser or check logs if the UI still looks stale."
  echo "Last response:"
  echo "  ${last_response:-<no response>}"
  echo "Last backend log lines:"
  tail -n 30 "$BACKEND_LOG" 2>/dev/null || true
}

verify_audio_engine_api() {
  local url="http://127.0.0.1:$AUDIO_ENGINE_PORT/health"
  local response

  if ! command -v curl >/dev/null 2>&1; then
    return
  fi

  for _ in {1..40}; do
    if ! pid_is_running "$AUDIO_ENGINE_PID"; then
      echo "Audio engine exited before the API became ready. Last log lines:"
      tail -n 30 "$AUDIO_ENGINE_LOG" 2>/dev/null || true
      return
    fi

    response="$(curl -fsS --max-time 1 "$url" 2>/dev/null || true)"
    if [[ "$response" == *'"status":"ok"'* || "$response" == *'"status": "ok"'* ]]; then
      return
    fi
    sleep 0.25
  done

  echo "Audio engine started, but /health did not become ready."
  echo "Continuing startup; check logs if mixer controls fail."
  tail -n 30 "$AUDIO_ENGINE_LOG" 2>/dev/null || true
}

start_audio_engine() {
  ensure_dirs
  if pid_is_running "$AUDIO_ENGINE_PID"; then
    echo "Audio engine already running: PID $(cat "$AUDIO_ENGINE_PID")"
    return
  fi
  stop_project_processes "Audio engine" "$AUDIO_ENGINE_DIR" "(uvicorn|python).*app\.main:app"
  stop_port_processes "Audio engine" "$AUDIO_ENGINE_PORT"

  if [[ ! -x "$AUDIO_ENGINE_DIR/.venv/bin/uvicorn" ]]; then
    echo "Audio engine venv is missing. Run:"
    echo "  ./rpgctl build"
    exit 1
  fi

  (
    cd "$AUDIO_ENGINE_DIR"
    if command -v setsid >/dev/null 2>&1; then
      nohup setsid .venv/bin/uvicorn app.main:app --host "$AUDIO_ENGINE_HOST" --port "$AUDIO_ENGINE_PORT" >"$AUDIO_ENGINE_LOG" 2>&1 &
    else
      nohup .venv/bin/uvicorn app.main:app --host "$AUDIO_ENGINE_HOST" --port "$AUDIO_ENGINE_PORT" >"$AUDIO_ENGINE_LOG" 2>&1 &
    fi
    echo "$!" >"$AUDIO_ENGINE_PID"
  )

  echo "Audio engine started: PID $(cat "$AUDIO_ENGINE_PID")"
  wait_for_start "Audio engine" "$AUDIO_ENGINE_PID" "$AUDIO_ENGINE_LOG"
  verify_audio_engine_api
}

start_spotify() {
  ensure_dirs
  if pid_is_running "$SPOTIFY_PID"; then
    echo "Spotify already running: PID $(cat "$SPOTIFY_PID")"
    return
  fi
  stop_project_processes "Spotify" "$SPOTIFY_DIR" "(librespot|python.*service[.]py)"
  wait_for_audio_server
  # The engine owns the stereo sink and upmix worker. Never fall back to hardware.
  start_audio_engine
  run_mixer_api_command start
  (
    cd "$SPOTIFY_DIR"
    if command -v setsid >/dev/null 2>&1; then
      nohup setsid env STEREO_UPMIX_SINK_NAME="$STEREO_UPMIX_SINK_NAME" python3 service.py >"$SPOTIFY_LOG" 2>&1 &
    else
      nohup env STEREO_UPMIX_SINK_NAME="$STEREO_UPMIX_SINK_NAME" python3 service.py >"$SPOTIFY_LOG" 2>&1 &
    fi
    echo "$!" >"$SPOTIFY_PID"
  )
  wait_for_start "Spotify" "$SPOTIFY_PID" "$SPOTIFY_LOG"
  echo "Spotify Connect started: PID $(cat "$SPOTIFY_PID")"
}

build_spotify() {
  require_command "python3" "Install Python 3.11+."
  bash "$SPOTIFY_DIR/build.sh"
}

start_backend() {
  ensure_dirs
  if pid_is_running "$BACKEND_PID"; then
    echo "Backend already running: PID $(cat "$BACKEND_PID")"
    return
  fi
  stop_project_processes "Backend" "$BACKEND_DIR" "(uvicorn|python).*app\.main:app"
  stop_port_processes "Backend" "$BACKEND_PORT"

  if [[ ! -x "$BACKEND_DIR/.venv/bin/uvicorn" ]]; then
    echo "Backend venv is missing. Run:"
    echo "  cd backend"
    echo "  python3 -m venv .venv"
    echo "  .venv/bin/python -m pip install -r requirements-dev.txt"
    exit 1
  fi

  (
    cd "$BACKEND_DIR"
    if command -v setsid >/dev/null 2>&1; then
      nohup setsid env AUDIO_ENGINE_URL="$AUDIO_ENGINE_URL" FRONTEND_ORIGIN="$FRONTEND_ORIGIN" .venv/bin/uvicorn app.main:app --host "$BACKEND_HOST" --port "$BACKEND_PORT" >"$BACKEND_LOG" 2>&1 &
    else
      nohup env AUDIO_ENGINE_URL="$AUDIO_ENGINE_URL" FRONTEND_ORIGIN="$FRONTEND_ORIGIN" .venv/bin/uvicorn app.main:app --host "$BACKEND_HOST" --port "$BACKEND_PORT" >"$BACKEND_LOG" 2>&1 &
    fi
    echo "$!" >"$BACKEND_PID"
  )

  echo "Backend started: PID $(cat "$BACKEND_PID")"
  wait_for_start "Backend" "$BACKEND_PID" "$BACKEND_LOG"
  verify_backend_api
}

start_bluetooth_agent() {
  ensure_dirs
  if pid_is_running "$BLUETOOTH_AGENT_PID"; then
    echo "Bluetooth agent already running: PID $(cat "$BLUETOOTH_AGENT_PID")"
    return
  fi
  stop_project_processes "Bluetooth agent" "$BACKEND_DIR" "(python).*scripts/bluez_pairing_agent\.py"

  if [[ ! -x "$BACKEND_DIR/.venv/bin/python" ]]; then
    echo "Backend venv is missing. Run:"
    echo "  ./rpgctl build"
    exit 1
  fi

  (
    cd "$BACKEND_DIR"
    if command -v setsid >/dev/null 2>&1; then
      nohup setsid env \
        BACKEND_URL="http://127.0.0.1:$BACKEND_PORT" \
        BLUEZ_ADAPTER_PATH="$BLUEZ_ADAPTER_PATH" \
        STEREO_UPMIX_SINK_NAME="$STEREO_UPMIX_SINK_NAME" \
        .venv/bin/python scripts/bluez_pairing_agent.py >"$BLUETOOTH_AGENT_LOG" 2>&1 &
    else
      nohup env \
        BACKEND_URL="http://127.0.0.1:$BACKEND_PORT" \
        BLUEZ_ADAPTER_PATH="$BLUEZ_ADAPTER_PATH" \
        STEREO_UPMIX_SINK_NAME="$STEREO_UPMIX_SINK_NAME" \
        .venv/bin/python scripts/bluez_pairing_agent.py >"$BLUETOOTH_AGENT_LOG" 2>&1 &
    fi
    echo "$!" >"$BLUETOOTH_AGENT_PID"
  )

  echo "Bluetooth agent started: PID $(cat "$BLUETOOTH_AGENT_PID")"
  wait_for_start "Bluetooth agent" "$BLUETOOTH_AGENT_PID" "$BLUETOOTH_AGENT_LOG"
}

start_frontend() {
  ensure_dirs
  if pid_is_running "$FRONTEND_PID"; then
    echo "Frontend already running: PID $(cat "$FRONTEND_PID")"
    return
  fi
  stop_project_processes "Frontend" "$FRONTEND_DIR" "(production_server\.py|npm run dev|vite|node).*vite"
  stop_port_processes "Frontend" "$FRONTEND_PORT"

  if [[ ! -f "$FRONTEND_DIR/dist/index.html" ]]; then
    echo "Frontend production build is missing. Run:"
    echo "  ./rpgctl build"
    exit 1
  fi
  if [[ ! -f "$FRONTEND_AUTH_FILE" ]]; then
    echo "Frontend authentication is not configured. Run:"
    echo "  ./rpgctl add-user <username>"
    exit 1
  fi
  if [[ ! -f "$FRONTEND_TLS_CERT" || ! -f "$FRONTEND_TLS_KEY" ]]; then
    echo "Frontend TLS certificate or key is missing. Run:"
    echo "  ./rpgctl setup-https home.dyyyl.ovh"
    echo "Or set FRONTEND_TLS_CERT and FRONTEND_TLS_KEY to trusted certificate files."
    exit 1
  fi

  local lan_ip
  lan_ip="$(detect_lan_ip)"

  (
    cd "$FRONTEND_DIR"
    if command -v setsid >/dev/null 2>&1; then
      nohup setsid python3 production_server.py \
        --auth-file "$FRONTEND_AUTH_FILE" \
        --tls-cert "$FRONTEND_TLS_CERT" \
        --tls-key "$FRONTEND_TLS_KEY" \
        --frontend-origin "$FRONTEND_ORIGIN" \
        --host "$FRONTEND_HOST" \
        --port "$FRONTEND_PORT" \
        --backend-port "$BACKEND_PORT" >"$FRONTEND_LOG" 2>&1 &
    else
      nohup python3 production_server.py \
        --auth-file "$FRONTEND_AUTH_FILE" \
        --tls-cert "$FRONTEND_TLS_CERT" \
        --tls-key "$FRONTEND_TLS_KEY" \
        --frontend-origin "$FRONTEND_ORIGIN" \
        --host "$FRONTEND_HOST" \
        --port "$FRONTEND_PORT" \
        --backend-port "$BACKEND_PORT" >"$FRONTEND_LOG" 2>&1 &
    fi
    echo "$!" >"$FRONTEND_PID"
  )

  echo "Frontend started: PID $(cat "$FRONTEND_PID")"
  wait_for_start "Frontend" "$FRONTEND_PID" "$FRONTEND_LOG"
}

stop_pid() {
  local label="$1"
  local pid_file="$2"

  if ! pid_is_running "$pid_file"; then
    rm -f "$pid_file"
    echo "$label is not running."
    return
  fi

  local pid
  pid="$(cat "$pid_file")"
  stop_process_id "$pid"
  rm -f "$pid_file"
  echo "$label stopped."
}

print_mixer_command_result() {
  local command="$1"
  local response="$2"
  local pid
  local status

  pid="$(sed -n 's/.*"pid":[[:space:]]*\([0-9][0-9]*\).*/\1/p' <<<"$response")"
  status="$(sed -n 's/.*"status":[[:space:]]*"\([^"]*\)".*/\1/p' <<<"$response")"
  if [[ "$status" == "error" ]]; then
    echo "Mixer $command failed."
    return 1
  fi

  case "$command" in
    start)
      if [[ -n "$pid" ]]; then
        echo "Mixer started: PID $pid"
      else
        echo "Mixer started."
      fi
      ;;
    stop)
      echo "Mixer stopped."
      ;;
    restart)
      if [[ -n "$pid" ]]; then
        echo "Mixer restarted: PID $pid"
      else
        echo "Mixer restarted."
      fi
      ;;
    *)
      echo "Mixer $command complete."
      ;;
  esac
}

run_mixer_api_command() {
  local command="$1"
  local url="http://127.0.0.1:$AUDIO_ENGINE_PORT/mixer/$command"
  local response

  if ! pid_is_running "$AUDIO_ENGINE_PID"; then
    echo "Audio engine is not running; cannot $command mixer through audio engine."
    return 1
  fi

  if ! command -v curl >/dev/null 2>&1; then
    echo "Missing required command: curl"
    echo "Install curl, or control the mixer directly with ./rpgctl mixer $command."
    return 1
  fi

  if response="$(curl -fsS --max-time 5 -X POST "$url")"; then
    print_mixer_command_result "$command" "$response" || {
      echo "Check:"
      echo "  $AUDIO_ENGINE_LOG"
      return 1
    }
    return 0
  fi

  echo "Mixer $command failed through audio engine. Check:"
  echo "  $AUDIO_ENGINE_LOG"
  return 1
}

start_all() {
  wait_for_system_boot
  wait_for_audio_server
  start_audio_engine
  run_mixer_api_command start
  start_spotify
  start_backend
  start_bluetooth_agent
  start_frontend
  status
}

stop_all() {
  stop_pid "Frontend" "$FRONTEND_PID"
  stop_pid "Bluetooth agent" "$BLUETOOTH_AGENT_PID"
  stop_pid "Backend" "$BACKEND_PID"
  stop_pid "Spotify" "$SPOTIFY_PID"
  if pid_is_running "$AUDIO_ENGINE_PID"; then
    run_mixer_api_command stop || true
  fi
  stop_pid "Audio engine" "$AUDIO_ENGINE_PID"
  stop_stale_project_servers
}

status_line() {
  local label="$1"
  local pid_file="$2"
  local url="$3"

  if pid_is_running "$pid_file"; then
    echo "$label: running, PID $(cat "$pid_file"), $url"
  else
    echo "$label: stopped"
  fi
}

status() {
  local lan_ip
  lan_ip="$(detect_lan_ip)"
  status_line "Audio engine" "$AUDIO_ENGINE_PID" "http://127.0.0.1:$AUDIO_ENGINE_PORT"
  status_line "Spotify" "$SPOTIFY_PID" "Spotify Connect → $STEREO_UPMIX_SINK_NAME"
  status_line "Backend" "$BACKEND_PID" "http://$BACKEND_HOST:$BACKEND_PORT"
  status_line "Bluetooth agent" "$BLUETOOTH_AGENT_PID" "$BLUEZ_ADAPTER_PATH"
  status_line "Frontend" "$FRONTEND_PID" "$FRONTEND_ORIGIN"
}

follow_logs() {
  ensure_dirs
  touch "$AUDIO_ENGINE_LOG" "$BACKEND_LOG" "$BLUETOOTH_AGENT_LOG" "$FRONTEND_LOG" "$APP_LOG" "$SPOTIFY_LOG"
  tail -f "$AUDIO_ENGINE_LOG" "$BACKEND_LOG" "$BLUETOOTH_AGENT_LOG" "$FRONTEND_LOG" "$APP_LOG" "$SPOTIFY_LOG"
}

build_audio_engine() {
  require_command "python3" "Install Python 3.11+ and python3-venv."

  if [[ ! -d "$AUDIO_ENGINE_DIR/.venv" ]]; then
    echo "Creating audio engine virtual environment..."
    python3 -m venv "$AUDIO_ENGINE_DIR/.venv"
  fi

  echo "Installing audio engine dependencies..."
  "$AUDIO_ENGINE_DIR/.venv/bin/python" -m pip install -r "$AUDIO_ENGINE_DIR/requirements-dev.txt"

  echo "Compiling audio engine..."
  (
    cd "$AUDIO_ENGINE_DIR"
    .venv/bin/python -m compileall app scripts
  )
}

build_backend() {
  require_command "python3" "Install Python 3.11+ and python3-venv."

  if [[ ! -d "$BACKEND_DIR/.venv" ]]; then
    echo "Creating backend virtual environment..."
    python3 -m venv "$BACKEND_DIR/.venv"
  fi

  echo "Installing backend dependencies..."
  "$BACKEND_DIR/.venv/bin/python" -m pip install -r "$BACKEND_DIR/requirements-dev.txt"

  echo "Compiling backend..."
  (
    cd "$BACKEND_DIR"
    .venv/bin/python -m compileall app scripts
  )
}

build_frontend() {
  require_command "npm" "Install Node.js and npm."

  echo "Installing frontend dependencies..."
  (
    cd "$FRONTEND_DIR"
    if [[ -f package-lock.json ]]; then
      npm ci
    else
      npm install
    fi

    echo "Building frontend..."
    npm run build
  )
}

build_all() {
  build_audio_engine
  build_backend
  build_frontend
  build_spotify
  echo "Build complete."
}

manage_frontend_user() {
  ensure_dirs
  local action="$1"
  local username="${2:-}"
  local command_args=(
    --auth-file "$FRONTEND_AUTH_FILE"
    --manage-auth "$action"
  )
  if [[ -n "$username" ]]; then
    command_args+=(--username "$username")
  fi
  python3 "$FRONTEND_DIR/production_server.py" \
    "${command_args[@]}"
  if [[ "$action" != "list-user" ]] && pid_is_running "$FRONTEND_PID"; then
    echo "Restarting frontend to apply the user changes..."
    stop_component frontend
    start_component frontend
  fi
}

setup_frontend_https() {
  ensure_dirs
  require_command "openssl" "Install OpenSSL."
  local hostname="${1:-$(detect_lan_ip)}"
  local lan_ip
  lan_ip="$(detect_lan_ip)"
  local subject_alt_name="DNS:$hostname,IP:$lan_ip,IP:127.0.0.1"

  openssl req \
    -x509 \
    -newkey rsa:3072 \
    -sha256 \
    -days 365 \
    -nodes \
    -keyout "$FRONTEND_TLS_KEY" \
    -out "$FRONTEND_TLS_CERT" \
    -subj "/CN=$hostname" \
    -addext "subjectAltName=$subject_alt_name"
  chmod 600 "$FRONTEND_TLS_KEY"
  chmod 644 "$FRONTEND_TLS_CERT"
  echo "Generated self-signed frontend certificate:"
  echo "  certificate: $FRONTEND_TLS_CERT"
  echo "  private key: $FRONTEND_TLS_KEY"
  echo "Browsers must trust this certificate explicitly, or replace it with a CA-issued certificate."

  if pid_is_running "$FRONTEND_PID"; then
    echo "Restarting frontend to enable HTTPS..."
    stop_component frontend
    start_component frontend
  fi
}

run_mixer_command() {
  if [[ ! -x "$AUDIO_ENGINE_DIR/.venv/bin/python" ]]; then
    echo "Audio engine venv is missing. Run:"
    echo "  ./rpgctl build"
    exit 1
  fi
  (
    cd "$AUDIO_ENGINE_DIR"
    .venv/bin/python scripts/surround_mixer.py "$@"
  )
}

run_mixer_component_command() {
  local command="${1:-}"
  local response

  case "$command" in
    start|stop|restart)
      if pid_is_running "$AUDIO_ENGINE_PID"; then
        run_mixer_api_command "$command"
        return
      fi
      if response="$(run_mixer_command "$command")"; then
        print_mixer_command_result "$command" "$response"
        return
      fi
      echo "$response"
      return 1
      ;;
    *)
      echo "Unsupported mixer component command: $command"
      exit 1
      ;;
  esac
}

start_component() {
  case "${1:-}" in
    spotify)
      start_spotify
      ;;
    audio_engine)
      start_audio_engine
      ;;
    backend)
      start_backend
      ;;
    bluetooth)
      start_bluetooth_agent
      ;;
    frontend)
      start_frontend
      ;;
    mixer)
      run_mixer_component_command start
      ;;
    *)
      echo "Unknown component: ${1:-}"
      echo "Available components: ${RPGCTL_COMPONENTS[*]}"
      exit 1
      ;;
  esac
}

stop_component() {
  case "${1:-}" in
    spotify)
      stop_pid "Spotify" "$SPOTIFY_PID"
      stop_project_processes "Spotify" "$SPOTIFY_DIR" "(librespot|python.*service[.]py)"
      ;;
    audio_engine)
      stop_pid "Audio engine" "$AUDIO_ENGINE_PID"
      stop_project_processes "Audio engine" "$AUDIO_ENGINE_DIR" "(uvicorn|python).*app\.main:app"
      stop_port_processes "Audio engine" "$AUDIO_ENGINE_PORT"
      ;;
    backend)
      stop_pid "Backend" "$BACKEND_PID"
      stop_project_processes "Backend" "$BACKEND_DIR" "(uvicorn|python).*app\.main:app"
      stop_port_processes "Backend" "$BACKEND_PORT"
      ;;
    bluetooth)
      stop_pid "Bluetooth agent" "$BLUETOOTH_AGENT_PID"
      stop_project_processes "Bluetooth agent" "$BACKEND_DIR" "(python).*scripts/bluez_pairing_agent\.py"
      ;;
    frontend)
      stop_pid "Frontend" "$FRONTEND_PID"
      stop_project_processes "Frontend" "$FRONTEND_DIR" "(production_server\.py|npm run dev|vite|node).*vite"
      stop_port_processes "Frontend" "$FRONTEND_PORT"
      ;;
    mixer)
      run_mixer_component_command stop
      ;;
    *)
      echo "Unknown component: ${1:-}"
      echo "Available components: ${RPGCTL_COMPONENTS[*]}"
      exit 1
      ;;
  esac
}

restart_component() {
  case "${1:-}" in
    spotify)
      build_spotify
      stop_component "$1"
      start_component "$1"
      ;;
    audio_engine)
      build_audio_engine
      stop_component "$1"
      start_component "$1"
      ;;
    backend|bluetooth)
      build_backend
      stop_component "$1"
      start_component "$1"
      ;;
    frontend)
      build_frontend
      stop_component "$1"
      start_component "$1"
      ;;
    mixer)
      build_audio_engine
      run_mixer_component_command restart
      ;;
    *)
      echo "Unknown component: ${1:-}"
      echo "Available components: ${RPGCTL_COMPONENTS[*]}"
      exit 1
      ;;
  esac
}

case "${1:-}" in
  build)
    case "${2:-}" in
      "") build_all ;;
      spotify) build_spotify ;;
      audio_engine|mixer) build_audio_engine ;;
      backend|bluetooth) build_backend ;;
      frontend) build_frontend ;;
      *) echo "Unknown component: $2"; exit 1 ;;
    esac
    ;;
  start)
    if [[ -n "${2:-}" ]]; then
      start_component "$2"
    else
      start_all
    fi
    ;;
  stop)
    if [[ -n "${2:-}" ]]; then
      stop_component "$2"
    else
      stop_all
    fi
    ;;
  restart)
    if [[ -n "${2:-}" ]]; then
      restart_component "$2"
    else
      build_all
      stop_all
      start_all
    fi
    ;;
  status)
    status
    ;;
  logs)
    follow_logs
    ;;
  logs-spotify)
    ensure_dirs
    touch "$SPOTIFY_LOG"
    tail -f "$SPOTIFY_LOG"
    ;;
  logs-audio)
    ensure_dirs
    touch "$AUDIO_ENGINE_LOG"
    tail -f "$AUDIO_ENGINE_LOG"
    ;;
  logs-api)
    ensure_dirs
    touch "$BACKEND_LOG"
    tail -f "$BACKEND_LOG"
    ;;
  logs-bt)
    ensure_dirs
    touch "$BLUETOOTH_AGENT_LOG"
    tail -f "$BLUETOOTH_AGENT_LOG"
    ;;
  logs-ui)
    ensure_dirs
    touch "$FRONTEND_LOG"
    tail -f "$FRONTEND_LOG"
    ;;
  logs-app)
    ensure_dirs
    touch "$APP_LOG"
    tail -f "$APP_LOG"
    ;;
  mixer)
    shift
    run_mixer_command "$@"
    ;;
  add-user|remove-user|set-password)
    if [[ -z "${2:-}" ]]; then
      echo "$1 requires a username."
      echo "Usage: ./rpgctl $1 <username>"
      exit 1
    fi
    manage_frontend_user "$1" "$2"
    ;;
  list-user)
    manage_frontend_user list-user
    ;;
  setup-https)
    setup_frontend_https "${2:-$(detect_lan_ip)}"
    ;;
  completion)
    case "${2:-bash}" in
      bash)
        print_bash_completion
        ;;
      *)
        echo "Unsupported shell: ${2:-}"
        echo "Supported shells: bash"
        exit 1
        ;;
    esac
    ;;
  install-completion)
    install_completion
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage
    exit 1
    ;;
esac